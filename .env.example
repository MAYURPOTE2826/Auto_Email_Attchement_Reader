# Copy this file to .env and fill in your credentials
# DO NOT commit .env to Git

# Gmail Email Settings (required)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# IMAP Server (default: Gmail)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
ATTACHMENT_INBOX=inbox
# Set to "false" when using a non-Gmail IMAP server (Outlook, Yahoo, self-hosted)
USE_GMAIL_LABELS=true

# Email Processing Settings
MAX_EMAIL_SIZE_MB=20
SOCKET_TIMEOUT_SEC=30

# File Management
DOWNLOAD_FOLDER=attachments
# Lowered from 1000 — 100 attempts is generous without iterating thousands of stat() calls
MAX_FILENAME_ATTEMPTS=100
MIN_FREE_DISK_MB=500

# Database
DATABASE_PATH=processed_emails.db

# Logging
LOG_FILE=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
LOG_LEVEL=INFO
# Set LOG_JSON=true to emit newline-delimited JSON for ELK / Datadog / CloudWatch
LOG_JSON=false

# Application Behavior
CHECK_INTERVAL_SEC=30
MAX_RETRIES=5
RETRY_WAIT_SEC=10

# Per-email retry budget: how many additional attempts before marking an email
# permanently failed. Default 3 = up to 4 total attempts. Set to 0 for no retries.
MAX_EMAIL_RETRIES=3

# MIME bomb protection: maximum MIME parts parsed per email (default 200)
MAX_MIME_PARTS=200

# Alerting — email address to notify when the app stops unexpectedly (optional)
ALERT_EMAIL=
# SMTP relay for alert emails — change if your sender address is not Gmail
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465

# Security — sender allowlist (optional, recommended for production)
# Comma-separated list of permitted sender email addresses.
# Leave empty to accept email from any sender (default).
# Example: ALLOWED_SENDERS=boss@company.com,accounts@vendor.com
ALLOWED_SENDERS=

# Security — blocked file extensions (comma-separated, with leading dot)
# These attachment types are NEVER saved regardless of sender.
# Default covers common Windows malware vectors AND archive formats.
#
# NOTE: .zip, .7z, .rar, .tar, .gz are blocked by default because archives
# are the #1 ransomware delivery channel. Remove them only if your workflow
# genuinely requires receiving archive files, and document why.
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.com,.pif,.scr,.vbs,.vbe,.js,.jse,.ws,.wsh,.hta,.ps1,.psm1,.psd1,.reg,.msi,.jar,.msc,.lnk,.dll,.cpl,.zip,.7z,.rar,.tar,.gz,.bz2,.xz,.iso,.img,.dmg

# Security — blocked MIME Content-Types (comma-separated)
# Defence-in-depth: blocks renamed executables that still advertise their real type.
BLOCKED_MIME_TYPES=application/x-msdownload,application/x-executable,application/x-sh,application/x-bat,application/x-msdos-program,application/x-dosexec,application/x-winexe,application/x-java-archive
